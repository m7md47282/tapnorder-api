rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User roles
    match /userRoles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && 
        (get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['admin', 'cashier']);
    }
    
    // Menu items
    match /menuItems/{itemId} {
      allow read: if true; // Public read access
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['admin'];
    }
    
    // Orders
    match /orders/{orderId} {
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['admin', 'cashier', 'kitchen']);
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['admin', 'cashier', 'kitchen'];
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Restaurant settings
    match /settings/{settingId} {
      allow read: if true; // Public read access
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Tables
    match /tables/{tableId} {
      allow read: if true; // Public read access
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['admin', 'cashier'];
    }
    
    // Places
    match /places/{placeId} {
      allow read: if true; // Public read access
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
